{
  "openapi": "3.0.0",
  "info": {
    "title": "API Clínica Salud Integral",
    "description": "API REST para la gestión de la Clínica Salud Integral",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/especialidades": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/medicos/": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "especialidad",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/pacientes/": {
      "post": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Crear un paciente",
        "description": "Registra un nuevo paciente en la clínica.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string",
                  "example": "Juan"
                },
                "apellidoPaterno": {
                  "type": "string",
                  "example": "Pérez"
                },
                "apellidoMaterno": {
                  "type": "string",
                  "example": "Gómez"
                },
                "ci": {
                  "type": "string",
                  "example": "12345678"
                },
                "email": {
                  "type": "string",
                  "example": "juan@gmail.com"
                },
                "telefono": {
                  "type": "string",
                  "example": "70000000"
                },
                "direccion": {
                  "type": "string",
                  "example": "Santa Cruz"
                },
                "fechaNacimiento": {
                  "type": "string",
                  "example": "1995-05-20"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Paciente creado correctamente"
          },
          "400": {
            "description": "Datos del paciente inválidos"
          },
          "401": {
            "description": "Token no proporcionado o inválido"
          },
          "403": {
            "description": "No tienes permiso para acceder a este recurso"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Obtener todos los pacientes",
        "description": "Obtiene la lista de todos los pacientes.",
        "responses": {
          "200": {
            "description": "Lista de pacientes"
          },
          "401": {
            "description": "Token no proporcionado o inválido"
          },
          "403": {
            "description": "No tienes permiso para acceder a este recurso"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/pacientes/{id}": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Obtener paciente por ID",
        "description": "Obtiene un paciente específico junto con su historial de citas.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID del paciente",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paciente encontrado con su historial"
          },
          "400": {
            "description": "El ID debe ser un número entero"
          },
          "401": {
            "description": "Token no proporcionado o inválido"
          },
          "403": {
            "description": "No tienes permiso para acceder a este recurso"
          },
          "404": {
            "description": "Paciente no encontrado"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/citas/": {
      "post": {
        "tags": [
          "Citas"
        ],
        "summary": "Crear una cita",
        "description": "Agenda una cita para un paciente con un médico.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "pacienteId": {
                  "type": "number",
                  "example": 1
                },
                "medicoId": {
                  "type": "number",
                  "example": 1
                },
                "fechaHora": {
                  "type": "string",
                  "example": "2026-09-15T10:00:00"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Cita creada correctamente"
          },
          "400": {
            "description": "Datos inválidos o fecha pasada"
          },
          "401": {
            "description": "Token no proporcionado o inválido"
          },
          "403": {
            "description": "No tienes permiso para acceder a este recurso"
          },
          "404": {
            "description": "Paciente o médico no encontrado"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/citas/medico/{id}": {
      "get": {
        "tags": [
          "Citas"
        ],
        "summary": "Obtener agenda de un médico",
        "description": "Obtiene las citas de un médico y permite filtrarlas por rango de fechas.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID del médico",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "format": "date-time",
            "description": "Fecha inicial del rango",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "format": "date-time",
            "description": "Fecha final del rango",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agenda del médico"
          },
          "401": {
            "description": "Token no proporcionado o inválido"
          },
          "403": {
            "description": "No tienes permiso para acceder a este recurso"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/citas/{id}/estado": {
      "patch": {
        "tags": [
          "Citas"
        ],
        "summary": "Actualizar estado de una cita",
        "description": "Permite al médico marcar una cita como completada o cancelada.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de la cita",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado de la cita actualizado correctamente"
          },
          "400": {
            "description": "Estado de cita inválido"
          },
          "401": {
            "description": "Token no proporcionado o inválido"
          },
          "403": {
            "description": "No tienes permiso para acceder a este recurso"
          },
          "404": {
            "description": "Cita no encontrada"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "estado"
                ],
                "properties": {
                  "estado": {
                    "type": "string",
                    "enum": [
                      "COMPLETADA",
                      "CANCELADA"
                    ],
                    "example": "COMPLETADA"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "description": "",
        "responses": {
          "201": {
            "description": "Created"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "example": "any"
                  },
                  "password": {
                    "example": "any"
                  },
                  "role": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "example": "any"
                  },
                  "password": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}